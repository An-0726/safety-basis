{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "major-criteria-catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "wholeNormNotFieldFinding",
    "catalogScope",
    "allIndustryCoverage",
    "standards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "wholeNormNotFieldFinding": {
      "const": true
    },
    "catalogScope": {
      "const": "controlled_reviewed_standards_only"
    },
    "allIndustryCoverage": {
      "const": false
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lawVersionId",
          "standardVersion",
          "officialScope",
          "coverage",
          "clauses",
          "directHazardIds",
          "directHazardCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lawVersionId": {
            "type": "string"
          },
          "standardVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lawId",
              "name",
              "documentNumber",
              "versionKey",
              "officialSourceUrl",
              "effectiveDate",
              "endDate",
              "validityStatus"
            ],
            "properties": {
              "lawId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "documentNumber": {
                "type": "string"
              },
              "versionKey": {
                "type": "string"
              },
              "officialSourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "effectiveDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string"
              },
              "validityStatus": {
                "const": "active"
              }
            }
          },
          "officialScope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "sourceUrls",
              "wholeStandardComplete"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "sourceUrls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "wholeStandardComplete": {
                "type": "boolean"
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reviewedClauseCount",
              "reviewedWholeClauseCount",
              "reviewedSubitemClauseCount",
              "expectedWholeClauseCount",
              "expectedJudgmentItemCount",
              "reviewedJudgmentItemCount",
              "wholeStandardComplete"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reviewed_scope_complete",
                  "partial"
                ]
              },
              "reviewedClauseCount": {
                "type": "integer",
                "minimum": 0
              },
              "reviewedWholeClauseCount": {
                "type": "integer",
                "minimum": 0
              },
              "reviewedSubitemClauseCount": {
                "type": "integer",
                "minimum": 0
              },
              "expectedWholeClauseCount": {
                "type": "integer",
                "minimum": 0
              },
              "expectedJudgmentItemCount": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reviewedJudgmentItemCount": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "wholeStandardComplete": {
                "type": "boolean"
              },
              "expectedTableCount": {
                "type": "integer",
                "minimum": 1
              },
              "reviewedTableCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "dependentRequired": {
              "expectedTableCount": [
                "reviewedTableCount"
              ],
              "reviewedTableCount": [
                "expectedTableCount"
              ]
            }
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clauseId",
                "article",
                "quote",
                "lawVersionId",
                "sourceUrl",
                "checked",
                "status",
                "granularity",
                "directHazardIds"
              ],
              "properties": {
                "clauseId": {
                  "type": "string"
                },
                "article": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "lawVersionId": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "checked": {
                  "type": "string"
                },
                "status": {
                  "const": "现行有效"
                },
                "granularity": {
                  "enum": [
                    "whole_clause",
                    "subitem"
                  ]
                },
                "directHazardIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "contentParts": {
                  "$ref": "#/$defs/contentParts"
                },
                "applicationNotes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/applicationNote"
                  }
                }
              }
            }
          },
          "directHazardIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "directHazardCount": {
            "type": "integer",
            "minimum": 0
          },
          "publicationBasis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "legalSourceUrl",
              "checked",
              "fullTextPublicationApproved"
            ],
            "properties": {
              "basis": {
                "const": "copyright_law_article_5_official_administrative_document"
              },
              "legalSourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "checked": {
                "type": "string"
              },
              "fullTextPublicationApproved": {
                "const": true
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "officialScope": {
                  "properties": {
                    "wholeStandardComplete": {
                      "const": true
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "publicationBasis"
              ],
              "properties": {
                "coverage": {
                  "properties": {
                    "wholeStandardComplete": {
                      "const": true
                    },
                    "status": {
                      "const": "reviewed_scope_complete"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "clauses": {
                  "contains": {
                    "anyOf": [
                      {
                        "required": [
                          "contentParts"
                        ]
                      },
                      {
                        "required": [
                          "applicationNotes"
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "then": {
              "required": [
                "publicationBasis"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "clauses": {
                  "contains": {
                    "required": [
                      "contentParts"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "required": [
                    "expectedTableCount",
                    "reviewedTableCount"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "coverage": {
                  "required": [
                    "expectedTableCount"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "publicationBasis"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "textPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0009\\u000b-\\u001f]+$"
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "colSpan",
        "rowSpan"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0009\\u000b-\\u001f]+$"
        },
        "colSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "tablePart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "caption",
        "columnCount",
        "headerRows",
        "bodyRows",
        "sourcePages"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0009\\u000b-\\u001f]+$"
        },
        "columnCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "headerRows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/tableCell"
            }
          }
        },
        "bodyRows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/tableCell"
            }
          }
        },
        "sourcePages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    },
    "contentParts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "prefixItems": [
        {
          "$ref": "#/$defs/textPart"
        }
      ],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/textPart"
          },
          {
            "$ref": "#/$defs/tablePart"
          }
        ]
      },
      "contains": {
        "$ref": "#/$defs/tablePart"
      }
    },
    "applicationNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "isOfficialNormText",
        "summary",
        "sourceUrl",
        "sourceDate",
        "checked"
      ],
      "properties": {
        "kind": {
          "const": "official_application_clarification"
        },
        "isOfficialNormText": {
          "const": false
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0009\\u000b-\\u001f]+$"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/@:]+\\.gov\\.cn(?:/[^\\s]*)?$"
        },
        "sourceDate": {
          "type": "string",
          "format": "date"
        },
        "checked": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        }
      }
    }
  }
}
