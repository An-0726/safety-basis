    {
      "id": "H056",
      "cohort": "technical",
      "hazard": {
        "title": "实验室气体管道完整性或检维修空间不符合要求",
        "description": "在本项设计适用范围内，气体管道系统渗漏，或者耐压、耐温、耐腐蚀性能不符合要求，或者实验室内未留足清洁、维护和维修明露管道的空间。",
        "conditions": "适用于科学研究机构、工业企业、大专院校等新建、扩建、改建的科研建筑设计，且属于JGJ91-2019第10.1.1条范围的室内气体管道；不得泛化为所有企业、所有实验室或全部燃气使用场所的通用运行义务。本项核查管道系统性能，以及实验室内明露管道的清洁、维护和维修空间；其中任一不符合即应核查，不要求性能缺陷与空间不足同时存在。",
        "measures": "核查管道系统密封及耐压、耐温、耐腐蚀性能，处理不符合要求的部位；为实验室内明露管道保留足够的清洁、维护和维修空间。",
        "category": "危险化学品与危险物质",
        "places": [
          "科研建筑实验室内气体管道"
        ]
      },
      "displayCategory": "危险化学品与危险物质",
      "bases": [
        {
          "linkId": "K_BDCEFCB73FE7A8C76F7155",
          "clauseId": "C_JGJ91_10_2_5",
          "lawId": "LV_STD_JGJ91_2019",
          "lawName": "科研建筑设计标准 JGJ 91-2019",
          "role": "direct",
          "applicability": "适用于科学研究机构、工业企业、大专院校等新建、扩建、改建的科研建筑设计，且属于JGJ91-2019第10.1.1条范围的室内气体管道；不得泛化为所有企业、所有实验室或全部燃气使用场所的通用运行义务。本项核查管道系统性能，以及实验室内明露管道的清洁、维护和维修空间；其中任一不符合即应核查，不要求性能缺陷与空间不足同时存在。",
          "article": "第10.2.5条",
          "quote": "气体管道系统应不渗漏、耐压、耐温、耐腐蚀。实验室内应有足够的清洁、维护和维修明露管道的空间。",
          "sourceUrl": "https://ptysysglc.yangtzeu.edu.cn/__local/B/23/7C/489A0007EC53C93C354E5322D69_99824F79_150EB3A.pdf",
