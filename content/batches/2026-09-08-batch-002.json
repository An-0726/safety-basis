{
  "hazards": [
    {
      "id": "H025",
      "title": "消防设施、器材未按要求检验维修",
      "aliases": ["消防器材未定期检验", "消防设施未维修", "消防设施维护不到位"],
      "places": ["通用场所", "工贸企业", "仓储场所"],
      "category": "消防安全",
      "keywords": ["消防设施", "消防器材", "检验", "维修", "维护", "完好有效", "消防标志"],
      "description": "消防设施、器材未按要求定期组织检验、维修，或不能保持完好有效。",
      "measures": "建立消防设施、器材检查和维护计划，按适用要求实施检验、维修和更换，对发现的故障缺陷及时整改并留存可追溯记录；同步核查消防安全标志设置情况。",
      "note": "本条用于消防设施、器材维护管理层面的通用缺陷。若现场已经能够明确为灭火器失压、灭火器设置不当、消火栓遮挡等具体问题，优先使用对应具体条目，避免重复记录。",
      "mode": "直接适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H026",
      "title": "灭火器配置数量不足",
      "aliases": ["灭火器数量不足", "一个计算单元灭火器少于2具", "灭火器配置不足"],
      "places": ["通用场所", "工贸企业", "仓储场所"],
      "category": "消防安全",
      "keywords": ["灭火器", "数量", "配置", "计算单元", "少于2具", "灭火级别", "保护距离"],
      "description": "经按建筑灭火器配置要求划分计算单元后，该计算单元配置的灭火器数量少于规定的最低数量。",
      "measures": "先按场所用途、火灾种类、危险等级和建筑平面划分计算单元，再结合灭火级别和保护距离核算配置数量；确认不足后补配适用类型和规格的灭火器，并复核设置位置。",
      "note": "“一个计算单元内不得少于2具”不能机械理解为“每个房间、每个店铺必须固定2具”。必须先正确划分计算单元，并同时核对火灾种类、危险等级、灭火级别和最大保护距离。与现行强制性通用规范不一致时，以现行强制性规定为准。",
      "mode": "条件适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H027",
      "title": "灭火器设置环境条件不符合要求",
      "aliases": ["灭火器超温设置", "灭火器环境不适宜", "灭火器未采取防护"],
      "places": ["通用场所", "工贸企业", "仓储场所"],
      "category": "消防安全",
      "keywords": ["灭火器", "使用温度", "环境温度", "高温", "低温", "防护措施", "设置环境"],
      "description": "灭火器设置在可能超出其使用温度范围的场所，或未采取与设置场所环境条件相适应的防护措施。",
      "measures": "核实灭火器铭牌、产品资料规定的使用温度范围及现场环境条件；将器材调整至适宜位置，或采取防晒、防雨、防冻等与环境相适应且不影响取用的防护措施。",
      "note": "应依据具体灭火器产品适用温度和现场实测或可确认的环境条件判断，不能仅因设置在室外、高温设备附近等位置就直接认定超出使用范围。",
      "mode": "直接适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H028",
      "title": "灭火器未按要求维护、维修或报废更换",
      "aliases": ["灭火器未维护", "灭火器未维修", "灭火器超期未报废", "灭火器报废后未更换"],
      "places": ["通用场所", "工贸企业", "仓储场所"],
      "category": "消防安全",
      "keywords": ["灭火器", "维护", "维修", "报废", "更换", "等效替代", "检查"],
      "description": "灭火器未按要求进行维护、维修和报废，或报废后未按等效替代原则及时更换。",
      "measures": "建立灭火器台账和检查维护机制，依据器材状态及适用维护要求及时维修或报废；报废后按等效替代原则补充合格灭火器，确保原保护能力不降低。",
      "note": "失压、外观损伤、到期等具体状态是否需要维修或报废，应结合产品和维护要求判断；“失压”不等于当然报废。已有“灭火器失压”条目可用于记录现场具体状态，本条侧重维护管理义务。",
      "mode": "直接适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H029",
      "title": "配电线路缺少短路或过负荷保护",
      "aliases": ["配电线路无短路保护", "配电线路无过载保护", "配电线路保护缺失"],
      "places": ["配电系统", "生产车间", "通用场所"],
      "category": "电气安全",
      "keywords": ["配电线路", "短路保护", "过负荷保护", "过载保护", "断路器", "熔断器", "保护装置"],
      "description": "配电线路未按适用设计要求装设短路保护或过负荷保护。",
      "measures": "由电气专业人员核对线路导体截面、负荷特性、预期短路电流及现有保护装置参数，按适用要求补充或调整短路和过负荷保护，并验证上下级保护配合。",
      "note": "本条应结合具体配电系统和线路用途判断，不能把“装有漏电保护器”等同于已具备短路、过负荷保护；也不能仅凭保护器外观判断整定值和保护配合是否符合要求。",
      "mode": "条件适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H030",
      "title": "电气线路防机械损伤措施不足",
      "aliases": ["电线易受机械损伤", "电缆无机械防护", "线路未穿管保护"],
      "places": ["生产车间", "设备周边", "通用场所"],
      "category": "电气安全",
      "keywords": ["电气线路", "机械损伤", "碰撞", "挤压", "磨损", "穿管", "线槽", "防护"],
      "description": "配电线路敷设在可能受到碰撞、挤压、磨损等外部机械作用的位置，未采取有效防机械损伤措施。",
      "measures": "识别线路可能遭受机械作用的区段，根据环境采用穿管、线槽、护板、隔离或调整走向等措施，并检查已受损线路绝缘和机械强度，必要时更换。",
      "note": "标准要求是防止外部机械性损害，并不意味着所有可见线路一律必须穿金属管。应根据敷设方式、环境和实际受力风险选择适宜防护措施。",
      "mode": "条件适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H031",
      "title": "触电危险部位未设置安全警示标志",
      "aliases": ["未设置当心触电标志", "配电室无触电警示", "电气设备无警示标识"],
      "places": ["配电室", "生产车间", "通用场所"],
      "category": "电气安全",
      "keywords": ["当心触电", "触电", "安全警示标志", "配电室", "开关", "电气设备", "危险因素"],
      "description": "存在较大触电危险因素的电气设备、设施或场所未设置明显的安全警示标志。",
      "measures": "确认触电危险区域和设备后，在醒目、易识别且不易被遮挡的位置设置符合现行安全标志标准的警示标志，并纳入日常检查维护。",
      "note": "《安全生产法》第三十五条的适用前提是存在“较大危险因素”。不能把所有普通插座、日常低风险电器都机械要求张贴“当心触电”；具体图形、颜色和使用位置应执行现行GB 2894—2025。",
      "mode": "条件适用",
      "status": "已核验",
      "checked": "2026-09-08"
    },
    {
      "id": "H032",
      "title": "用电设备周围安全通道或工作空间不足",
      "aliases": ["配电箱前堆物", "电气设备前被占用", "用电设备周围无工作空间"],
      "places": ["配电设备周边", "生产车间", "通用场所"],
      "category": "电气安全",
      "keywords": ["用电设备", "安全通道", "工作空间", "配电箱", "堆物", "易燃", "易爆", "腐蚀性物品"],
      "description": "用电设备周围未留有足够的安全通道和工作空间，或周围堆放易燃、易爆、腐蚀性物品。",
      "measures": "清除妨碍操作、检查和维修的物品，恢复必要的安全通道和工作空间；将易燃、易爆、腐蚀性物品移至适宜区域，并建立防占用和巡查机制。",
      "note": "GB/T 13869—2017目前仍为现行推荐性国家标准，已发布的GB/T 13869—2026将于2027-02-01实施并全部代替2017版。当前判断仍以2017版为依据，到替代标准实施时应重新核对条款。",
      "mode": "直接适用",
      "status": "已核验",
      "checked": "2026-09-08"
    }
  ],
