{
  "schemaVersion": 2,
  "shard": "c0000",
  "records": [
    {
      "id": "C001",
      "lawId": "L001",
      "article": "第十六条第一款第（二）项",
      "quote": "按照国家标准、行业标准配置消防设施、器材，设置消防安全标志，并定期组织检验、维修，确保完好有效；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C002",
      "lawId": "L001",
      "article": "第二十八条第一句",
      "quote": "任何单位、个人不得损坏、挪用或者擅自拆除、停用消防设施、器材，不得埋压、圈占、遮挡消火栓或者占用防火间距，不得占用、堵塞、封闭疏散通道、安全出口、消防车通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C003",
      "lawId": "L002",
      "article": "第四十一条第二款（节选）",
      "quote": "生产经营单位应当建立健全并落实生产安全事故隐患排查治理制度，采取技术、管理措施，及时发现并消除事故隐患。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C004",
      "lawId": "L002",
      "article": "第四十二条第二款",
      "quote": "生产经营场所和员工宿舍应当设有符合紧急疏散要求、标志明显、保持畅通的出口、疏散通道。禁止占用、锁闭、封堵生产经营场所或者员工宿舍的出口、疏散通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C005",
      "lawId": "L001",
      "article": "第二十七条第二款",
      "quote": "电器产品、燃气用具的安装、使用及其线路、管路的设计、敷设、维护保养、检测，必须符合消防技术标准和管理规定。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C006",
      "lawId": "L002",
      "article": "第三十六条第四款",
      "quote": "餐饮等行业的生产经营单位使用燃气的，应当安装可燃气体报警装置，并保障其正常使用。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C007",
      "lawId": "L003",
      "article": "第三十三条第三、四款",
      "quote": "下列用户应当安装使用燃气泄漏安全保护装置：\n（一）餐饮用户；\n（二）在室内公共场所使用燃气的；\n（三）在符合用气条件的地下或者半地下建筑物内使用管道燃气的。\n前款所称燃气泄漏安全保护装置，指具有燃气泄漏报警和自动切断功能装置的总称，包括燃气泄漏报警器与紧急切断阀联动装置、燃气泄漏报警装置、熄火保护装置，过流和泄漏切断装置等。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C008",
      "lawId": "L004",
      "article": "第十二条第一款第（三）项（连同引导语）",
      "quote": "电动自行车使用者应当遵守消防安全有关法律、法规、规章，不得有下列行为：\n（三）违反安全用电要求乱拉电线和插座为电动自行车充电；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C009",
      "lawId": "L005",
      "article": "6.2.2.1",
      "quote": "调配涂料应在调漆室内进行。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C010",
      "lawId": "L006",
      "article": "第十八条第一款（节选）",
      "quote": "相关责任人员应当定期清理粉尘并如实记录，确保可能积尘的粉尘作业区域和设备设施全面及时规范清理。粉尘作业区域应当保证每班清理。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C011",
      "lawId": "L001",
      "article": "第十六条第一款第（三）项",
      "quote": "对建筑消防设施每年至少进行一次全面检测，确保完好有效，检测记录应当完整准确，存档备查；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C012",
      "lawId": "L007",
      "article": "10.0.7",
      "quote": "灭火器应定期维护、维修和报废。灭火器报废后，应按照等效替代的原则更换。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C013",
      "lawId": "L007",
      "article": "10.0.4",
      "quote": "灭火器应设置在位置明显和便于取用的地点，且不应影响人员安全疏散。当确需设置在有视线障碍的设置点时，应设置指示灭火器位置的醒目标志。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C014",
      "lawId": "L002",
      "article": "第二十八条第一款、第四款",
      "quote": "生产经营单位应当对从业人员进行安全生产教育和培训，保证从业人员具备必要的安全生产知识，熟悉有关的安全生产规章制度和安全操作规程，掌握本岗位的安全操作技能，了解事故应急处理措施，知悉自身在安全生产方面的权利和义务。未经安全生产教育和培训合格的从业人员，不得上岗作业。\n生产经营单位应当建立安全生产教育和培训档案，如实记录安全生产教育和培训的时间、内容、参加人员以及考核结果等情况。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C015",
      "lawId": "L002",
      "article": "第二十三条",
      "quote": "生产经营单位应当具备的安全生产条件所必需的资金投入，由生产经营单位的决策机构、主要负责人或者个人经营的投资人予以保证，并对由于安全生产所必需的资金投入不足导致的后果承担责任。\n有关生产经营单位应当按照规定提取和使用安全生产费用，专门用于改善安全生产条件。安全生产费用在成本中据实列支。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C016",
      "lawId": "L002",
      "article": "第四十五条",
      "quote": "生产经营单位必须为从业人员提供符合国家标准或者行业标准的劳动防护用品，并监督、教育从业人员按照使用规则佩戴、使用。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C017",
      "lawId": "L002",
      "article": "第四十六条第一款",
      "quote": "生产经营单位的安全生产管理人员应当根据本单位的生产经营特点，对安全生产状况进行经常性检查；对检查中发现的安全问题，应当立即处理；不能处理的，应当及时报告本单位有关负责人，有关负责人应当及时处理。检查及处理情况应当如实记录在案。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C018",
      "lawId": "L002",
      "article": "第二十一条第（一）项",
      "quote": "建立健全并落实本单位全员安全生产责任制，加强安全生产标准化建设；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C019",
      "lawId": "L002",
      "article": "第二十一条第（二）项",
      "quote": "组织制定并实施本单位安全生产规章制度和操作规程；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C020",
      "lawId": "L002",
      "article": "第二十一条第（五）项",
      "quote": "组织建立并落实安全风险分级管控和隐患排查治理双重预防工作机制，督促、检查本单位的安全生产工作，及时消除生产安全事故隐患；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C021",
      "lawId": "L001",
      "article": "第十六条第一款第（五）项",
      "quote": "组织防火检查，及时消除火灾隐患；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.119.gov.cn/gk/zcjd/2022/240.shtml"
    },
    {
      "id": "C022",
      "lawId": "L002",
      "article": "第二十四条",
      "quote": "矿山、金属冶炼、建筑施工、运输单位和危险物品的生产、经营、储存、装卸单位，应当设置安全生产管理机构或者配备专职安全生产管理人员。\n前款规定以外的其他生产经营单位，从业人员超过一百人的，应当设置安全生产管理机构或者配备专职安全生产管理人员；从业人员在一百人以下的，应当配备专职或者兼职的安全生产管理人员。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C023",
      "lawId": "L002",
      "article": "第三十八条第三款",
      "quote": "生产经营单位不得使用应当淘汰的危及生产安全的工艺、设备。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C024",
      "lawId": "L002",
      "article": "第四十一条第一款",
      "quote": "生产经营单位应当建立安全风险分级管控制度，按照安全风险分级采取相应的管控措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C025",
      "lawId": "L002",
      "article": "第二十二条",
      "quote": "生产经营单位的全员安全生产责任制应当明确各岗位的责任人员、责任范围和考核标准等内容。\n生产经营单位应当建立相应的机制，加强对全员安全生产责任制落实情况的监督考核，保证全员安全生产责任制的落实。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C026",
      "lawId": "L008",
      "article": "6.1.1",
      "quote": "一个计算单元内配置的灭火器数量不得少于2具。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://ghzrzyw.beijing.gov.cn/zhengwuxinxi/zcwj/qtwj/202409/P020240914543945101730.pdf"
    },
    {
      "id": "C027",
      "lawId": "L007",
      "article": "10.0.5",
      "quote": "灭火器不应设置在可能超出其使用温度范围的场所，并应采取与设置场所环境条件相适应的防护措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.yantian.gov.cn/ytjsj/attachment/1/1561/1561739/12083207.pdf"
    },
    {
      "id": "C028",
      "lawId": "L009",
      "article": "6.1.1",
      "quote": "配电线路应装设短路保护和过负荷保护。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://files.anshan.gov.cn/files/ueditor/ASJKQ/jsp/upload/file/20211201/1638343166465002256.pdf"
    },
    {
      "id": "C029",
      "lawId": "L009",
      "article": "7.1.2第3项",
      "quote": "应防止外部的机械性损害。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://files.anshan.gov.cn/files/ueditor/ASJKQ/jsp/upload/file/20211201/1638343166465002256.pdf"
    },
    {
      "id": "C030",
      "lawId": "L002",
      "article": "第三十五条",
      "quote": "生产经营单位应当在有较大危险因素的生产经营场所和有关设施、设备上，设置明显的安全警示标志。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://source.nra.gov.cn/jglz/apjc/zcfg/202605/t20260530_351349.shtml"
    },
    {
      "id": "C031",
      "lawId": "L010",
      "article": "5.1.1",
      "quote": "一般条件下，用电产品的周围应留有足够的安全通道和工作空间，且不应堆放易燃、易爆和腐蚀性物品。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://wlt.fujian.gov.cn/zwgk/zcfg/zxwj/202603/P020260330570851056605.pdf"
    },
    {
      "id": "C032",
      "lawId": "L012",
      "article": "5.2",
      "quote": "应选择符合危险化学品的特性、防火要求及化学品安全技术说明书中储存要求的仓储设施进行储存。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://openstd.samr.gov.cn/"
    },
    {
      "id": "C033",
      "lawId": "L002",
      "article": "第二十七条",
      "quote": "生产经营单位的主要负责人和安全生产管理人员必须具备与本单位所从事的生产经营活动相应的安全生产知识和管理能力。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C034",
      "lawId": "L013",
      "article": "6.5.2",
      "quote": "治理系统与主体生产装置之间的管道系统应安装阻火器（防火阀），阻火器性能应符合GB 13347的规定。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/other/hjbhgc/201304/t20130403_250331.htm"
    },
    {
      "id": "C035",
      "lawId": "L014",
      "article": "第四十条",
      "quote": "特种设备使用单位应当按照安全技术规范的要求，在检验合格有效期届满前一个月向特种设备检验机构提出定期检验要求。特种设备检验机构接到定期检验要求后，应当按照安全技术规范的要求及时进行安全性能检验。特种设备使用单位应当将定期检验标志置于该特种设备的显著位置。未经定期检验或者检验不合格的特种设备，不得继续使用。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/fgs/art/2023/art_ad5e293574484b48b45047ee0ede6099.html"
    },
    {
      "id": "C036",
      "lawId": "L015",
      "article": "6.3",
      "quote": "室内储存场所不应设置员工宿舍。甲、乙类物品的室内储存场所内不应设办公室。其他室内储存场所确需设办公室时，其耐火等级应为一、二级，且门、窗应直通库外。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C037",
      "lawId": "L016",
      "article": "5.4.1",
      "quote": "风机应符合国家和行业相应产品标准，其选型应满足所处理介质的要求。输送有爆炸和易燃气体的应选防爆型风机。当离心通风机布置在非爆炸环境场所时，宜选择风机叶轮防爆而风机电机不防爆的防爆风机；输送煤粉的应选择煤粉风机；输送有腐蚀性气体的应选择防腐风机；在高温场合工作或输送高温气体的应选择高温风机；输送浓度较大的含尘气体应选用排尘风机等。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/other/hjbhgc/201012/t20101224_199112.htm"
    },
    {
      "id": "C038",
      "lawId": "L013",
      "article": "6.5.3",
      "quote": "风机、电机和置于现场的电气仪表等应不低于现场防爆等级。当吸附剂采用降压解吸方式再生且解吸后的高浓度有机气体采用液体吸收工艺进行回收时，风机、真空解吸泵和电气系统均应采用符合GB 3836.4要求的本安型防爆器件。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/other/hjbhgc/201304/t20130403_250331.htm"
    },
    {
      "id": "C039",
      "lawId": "L002",
      "article": "第三十条",
      "quote": "生产经营单位的特种作业人员必须按照国家有关规定经专门的安全作业培训，取得相应资格，方可上岗作业。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C040",
      "lawId": "L017",
      "article": "8.3",
      "quote": "危险化学品使用作业场所内不得设置与生产无关的生活设施等。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://std.samr.gov.cn/db/search/stdDBDetailed?id=E395E2E5CA792B21E05397BE0A0AFCB3"
    },
    {
      "id": "C041",
      "lawId": "L018",
      "article": "第十七条",
      "quote": "建设项目安全设施的施工应当由取得相应资质的施工单位进行，并与建设项目主体工程同时施工。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/gk/zfxxgkpt/fdzdgknr/gz11/201102/t20110201_405595.shtml"
    },
    {
      "id": "C042",
      "lawId": "L015",
      "article": "4.1",
      "quote": "开展消防法律法规和防火安全知识的教育，对员工进行消防安全培训。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C043",
      "lawId": "L001",
      "article": "第二十八条",
      "quote": "不得占用、堵塞、封闭疏散通道、安全出口、消防车通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_e9e34f0731c249a891ea9c925e17f237.html"
    },
    {
      "id": "C044",
      "lawId": "L002",
      "article": "第四十条",
      "quote": "生产经营单位对重大危险源应当登记建档，进行定期检测、评估、监控，并制定应急预案，告知从业人员和相关人员在紧急情况下应当采取的应急措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C045",
      "lawId": "L020",
      "article": "第十五条第（一）项",
      "quote": "每季度至少组织并参与一次安全生产全面检查，研究分析和解决安全生产存在问题。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.jsrd.gov.cn/qwfb/sjfg/202304/t20230410_1221265.shtml"
    },
    {
      "id": "C046",
      "lawId": "L020",
      "article": "第十五条第（二）项",
      "quote": "每年至少组织并参与一次生产安全事故应急救援演练。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.jsrd.gov.cn/qwfb/sjfg/202304/t20230410_1221265.shtml"
    },
    {
      "id": "C047",
      "lawId": "L020",
      "article": "第十五条第（三）项",
      "quote": "每年至少组织一次全面的安全风险辨识，制定完善管控措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.jsrd.gov.cn/qwfb/sjfg/202304/t20230410_1221265.shtml"
    },
    {
      "id": "C048",
      "lawId": "L002",
      "article": "第八十三条",
      "quote": "单位负责人接到事故报告后，应当迅速采取有效措施，组织抢救，防止事故扩大，减少人员伤亡和财产损失，并按照国家有关规定立即如实报告当地负有安全生产监督管理职责的部门。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C049",
      "lawId": "L020",
      "article": "第十五条第（五）项",
      "quote": "每年通过职工大会或者职工代表大会、信息公示栏等，向从业人员报告或者通报安全生产工作以及个人履行安全生产职责的情况，接受从业人员监督。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.jsrd.gov.cn/qwfb/sjfg/202304/t20230410_1221265.shtml"
    },
    {
      "id": "C050",
      "lawId": "L002",
      "article": "第四十二条",
      "quote": "生产、经营、储存、使用危险物品的车间、商店、仓库不得与员工宿舍在同一座建筑物内，并应当与员工宿舍保持安全距离。生产经营场所和员工宿舍应当设有符合紧急疏散要求、标志明显、保持畅通的出口、疏散通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C051",
      "lawId": "L015",
      "article": "6.8 b)",
      "quote": "物品与照明灯之间的距离不小于0.5m。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C052",
      "lawId": "L015",
      "article": "6.8 c)",
      "quote": "物品与墙之间的距离不小于0.5m。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C053",
      "lawId": "L015",
      "article": "6.8 d)",
      "quote": "物品堆垛与柱之间的距离不小于0.3m。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C054",
      "lawId": "L015",
      "article": "6.8 e)",
      "quote": "物品堆垛与堆垛之间的距离不小于1m。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C055",
      "lawId": "L021",
      "article": "10.2.5",
      "quote": "气体管道系统应不渗漏、耐压、耐温、耐腐蚀。实验室内应有足够的清洁、维护和维修明露管道的空间。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.zhc.dicp.ac.cn/info/1033/2831.htm"
    },
    {
      "id": "C056",
      "lawId": "L009",
      "article": "7.1.2",
      "quote": "配电线路的敷设，应避免下列外部环境的影响：在有大量灰尘的场所，应避免由于灰尘聚集在布线上所带来的影响。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://files.anshan.gov.cn/files/ueditor/ASJKQ/jsp/upload/file/20211201/1638343166465002256.pdf"
    },
    {
      "id": "C057",
      "lawId": "L015",
      "article": "3.3.2",
      "quote": "仓储场所在员工上岗、转岗前，应对其进行消防安全培训；对在岗人员至少每半年应进行一次消防安全教育。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C058",
      "lawId": "L015",
      "article": "8.11",
      "quote": "仓储场所应按照GB 50057设置防雷与接地系统，并应每年检测一次，其中甲、乙类仓储场所的防雷装置应每半年检测一次，并应取得专业部门测试合格证书。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C059",
      "lawId": "L015",
      "article": "10.7",
      "quote": "仓储场所设置的消火栓应有明显标志。室内消火栓箱不应上锁，箱内设备应齐全、完好。距室外消火栓、水泵接合器2m范围内不应设置影响其正常使用的障碍物。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C060",
      "lawId": "L002",
      "article": "第四十九条",
      "quote": "生产经营单位对承包单位、承租单位的安全生产工作统一协调、管理，定期进行安全检查，发现安全问题的，应当及时督促整改。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C061",
      "lawId": "L015",
      "article": "5.1.1",
      "quote": "仓储场所每月应至少组织一次防火检查，各部门（班组）每周应至少开展一次防火检查。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C062",
      "lawId": "L021",
      "article": "5.2.4",
      "quote": "甲、乙类危险物品不应储存在科研建筑的地下室和半地下室内。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.zhc.dicp.ac.cn/info/1033/2831.htm"
    },
    {
      "id": "C063",
      "lawId": "L023",
      "article": "4.1",
      "quote": "产生、收集、贮存、利用、处置危险废物的单位应建造危险废物贮存设施或设置贮存场所，并根据需要选择贮存设施类型。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/gthw/gtfwwrkzbz/202302/t20230224_1017500.shtml"
    },
    {
      "id": "C064",
      "lawId": "L024",
      "article": "4.2.2.5",
      "quote": "易燃气体不应与助燃气体同库储存。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=BD4BA33D46B2AD5DCA3F1EBA7E99BEE6"
    },
    {
      "id": "C065",
      "lawId": "L029",
      "article": "3.4.5第1项",
      "quote": "道路的净宽度和净空高度应满足消防车安全、快速通行的要求。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/group1/M00/01/D6/rBPe7Wi5YSWATAAkABU9IFBisPA109.pdf"
    },
    {
      "id": "C066",
      "lawId": "L015",
      "article": "3.3.1",
      "quote": "仓储场所应组织或者协助有关部门对消防安全责任人、消防安全管理人、消防控制室的值班操作人员进行消防安全专门培训。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C067",
      "lawId": "L023",
      "article": "6.1.2",
      "quote": "贮存设施应根据危险废物的类别、数量、形态、物理化学性质和污染防治等要求设置必要的贮存分区，避免不相容的危险废物接触、混合。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/gthw/gtfwwrkzbz/202302/t20230224_1017500.shtml"
    },
    {
      "id": "C068",
      "lawId": "L015",
      "article": "6.8 a)",
      "quote": "堆垛上部与楼板、平屋顶之间的距离不小于0.3m（人字屋架从横梁算起）。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://js.119.gov.cn/202111/206aebe848d24575894f22639ff3e721_c_f81c74d68ace4f1db1c5.html"
    },
    {
      "id": "C069",
      "lawId": "L013",
      "article": "6.5.4",
      "quote": "在吸附操作周期内，吸附了有机气体后吸附床内的温度应低于83℃。当吸附装置内的温度超过83℃时，应能自动报警，并立即启动降温装置。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/other/hjbhgc/201304/t20130403_250331.htm"
    },
    {
      "id": "C070",
      "lawId": "L010",
      "article": "第9条",
      "quote": "电气作业人员在进行电气作业前应熟悉作业环境，并根据作业的类型和性质采取相应的防护措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=1C5996A8BAD63FF484CCFE024D98849C"
    },
    {
      "id": "C071",
      "lawId": "L010",
      "article": "第9条",
      "quote": "进行电气作业时，所使用的电工个体防护用品应保证合格并与作业活动相适应。从事电气作业中的特种作业人员应经专门的安全作业培训，在取得相应特种作业操作资格证书后，方可上岗。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=1C5996A8BAD63FF484CCFE024D98849C"
    },
    {
      "id": "C072",
      "lawId": "L001",
      "article": "第二十一条",
      "quote": "禁止在具有火灾、爆炸危险的场所吸烟、使用明火。因施工等特殊情况需要使用明火作业的，应当按照规定事先办理审批手续，采取相应的消防安全措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_e9e34f0731c249a891ea9c925e17f237.html"
    },
    {
      "id": "C073",
      "lawId": "L001",
      "article": "第二十一条",
      "quote": "进行电焊、气焊等具有火灾危险作业的人员和自动消防系统的操作人员，必须持证上岗，并遵守消防安全操作规程。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_e9e34f0731c249a891ea9c925e17f237.html"
    },
    {
      "id": "C074",
      "lawId": "L017",
      "article": "8.2",
      "quote": "危险化学品使用作业场所应保持整洁有序，不得占用疏散通道，不得设置影响逃生和灭火救援的障碍物。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://std.samr.gov.cn/db/search/stdDBDetailed?id=E395E2E5CA792B21E05397BE0A0AFCB3"
    },
    {
      "id": "C075",
      "lawId": "L026",
      "article": "5.3.1",
      "quote": "喷漆区的通风量应确保可燃气体浓度不大于其爆炸下限的25%。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=76D3F954F575512DC1A4894370A8A84F"
    },
    {
      "id": "C076",
      "lawId": "L021",
      "article": "5.3.3",
      "quote": "使用强酸、强碱等有化学品危险隐患的实验室，应就近设置应急洗眼器及应急喷淋。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.zhc.dicp.ac.cn/info/1033/2831.htm"
    },
    {
      "id": "C077",
      "lawId": "L027",
      "article": "4.3",
      "quote": "危险废物产生单位应当对本单位工作人员进行培训。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/bz/bzwb/other/hjbhgc/201212/t20121231_244484.htm"
    },
    {
      "id": "C078",
      "lawId": "L018",
      "article": "第十条",
      "quote": "生产经营单位在建设项目初步设计时，应当委托有相应资质的设计单位对建设项目安全设施同时进行设计，编制安全设施设计。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/gk/zfxxgkpt/fdzdgknr/gz11/201102/t20110201_405595.shtml"
    },
    {
      "id": "C079",
      "lawId": "L021",
      "article": "5.2.5",
      "quote": "当易发生火灾、爆炸、极低温和其他危险化学品引发事故的实验室与其他用房相邻时，必须形成独立的防护单元，并应符合下列规定：1 防护单元的围护结构，应采用耐火极限不低于1.5h的楼板和耐火极限不低于2.0h的隔墙与其他用房分隔。2 门、窗应采用甲级防火门、窗，并应有防盗功能。3 易发生火灾、爆炸或缺氧危险的实验室应设置独立的通风系统。4 有爆炸危险的实验室应设置泄压设施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.zhc.dicp.ac.cn/info/1033/2831.htm"
    },
    {
      "id": "C080",
      "lawId": "L002",
      "article": "第八十一条",
      "quote": "生产经营单位应当制定本单位生产安全事故应急救援预案，与所在地县级以上地方人民政府组织制定的生产安全事故应急救援预案相衔接，并定期组织演练。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    }
  ]
}
