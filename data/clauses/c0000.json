  "records": [
    {
      "id": "C001",
      "lawId": "L001",
      "article": "第十六条第一款第（二）项",
      "quote": "按照国家标准、行业标准配置消防设施、器材，设置消防安全标志，并定期组织检验、维修，确保完好有效；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C002",
      "lawId": "L001",
      "article": "第二十八条第一句",
      "quote": "任何单位、个人不得损坏、挪用或者擅自拆除、停用消防设施、器材，不得埋压、圈占、遮挡消火栓或者占用防火间距，不得占用、堵塞、封闭疏散通道、安全出口、消防车通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C003",
      "lawId": "L002",
      "article": "第四十一条第二款（节选）",
      "quote": "生产经营单位应当建立健全并落实生产安全事故隐患排查治理制度，采取技术、管理措施，及时发现并消除事故隐患。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C004",
      "lawId": "L002",
      "article": "第四十二条第二款",
      "quote": "生产经营场所和员工宿舍应当设有符合紧急疏散要求、标志明显、保持畅通的出口、疏散通道。禁止占用、锁闭、封堵生产经营场所或者员工宿舍的出口、疏散通道。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C005",
      "lawId": "L001",
      "article": "第二十七条第二款",
      "quote": "电器产品、燃气用具的安装、使用及其线路、管路的设计、敷设、维护保养、检测，必须符合消防技术标准和管理规定。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C006",
      "lawId": "L002",
      "article": "第三十六条第四款",
      "quote": "餐饮等行业的生产经营单位使用燃气的，应当安装可燃气体报警装置，并保障其正常使用。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C007",
      "lawId": "L003",
      "article": "第三十三条第三、四款",
      "quote": "下列用户应当安装使用燃气泄漏安全保护装置：\n（一）餐饮用户；\n（二）在室内公共场所使用燃气的；\n（三）在符合用气条件的地下或者半地下建筑物内使用管道燃气的。\n前款所称燃气泄漏安全保护装置，指具有燃气泄漏报警和自动切断功能装置的总称，包括燃气泄漏报警器与紧急切断阀联动装置、燃气泄漏报警装置、熄火保护装置，过流和泄漏切断装置等。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C008",
      "lawId": "L004",
      "article": "第十二条第一款第（三）项（连同引导语）",
      "quote": "电动自行车使用者应当遵守消防安全有关法律、法规、规章，不得有下列行为：\n（三）违反安全用电要求乱拉电线和插座为电动自行车充电；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C009",
      "lawId": "L005",
      "article": "6.2.2.1",
      "quote": "调配涂料应在调漆室内进行。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C010",
      "lawId": "L006",
      "article": "第十八条第一款（节选）",
      "quote": "相关责任人员应当定期清理粉尘并如实记录，确保可能积尘的粉尘作业区域和设备设施全面及时规范清理。粉尘作业区域应当保证每班清理。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C011",
      "lawId": "L001",
      "article": "第十六条第一款第（三）项",
      "quote": "对建筑消防设施每年至少进行一次全面检测，确保完好有效，检测记录应当完整准确，存档备查；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C012",
      "lawId": "L007",
      "article": "10.0.7",
      "quote": "灭火器应定期维护、维修和报废。灭火器报废后，应按照等效替代的原则更换。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C013",
      "lawId": "L007",
      "article": "10.0.4",
      "quote": "灭火器应设置在位置明显和便于取用的地点，且不应影响人员安全疏散。当确需设置在有视线障碍的设置点时，应设置指示灭火器位置的醒目标志。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": ""
    },
    {
      "id": "C014",
      "lawId": "L002",
      "article": "第二十八条第一款、第四款",
      "quote": "生产经营单位应当对从业人员进行安全生产教育和培训，保证从业人员具备必要的安全生产知识，熟悉有关的安全生产规章制度和安全操作规程，掌握本岗位的安全操作技能，了解事故应急处理措施，知悉自身在安全生产方面的权利和义务。未经安全生产教育和培训合格的从业人员，不得上岗作业。\n生产经营单位应当建立安全生产教育和培训档案，如实记录安全生产教育和培训的时间、内容、参加人员以及考核结果等情况。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C015",
      "lawId": "L002",
      "article": "第二十三条",
      "quote": "生产经营单位应当具备的安全生产条件所必需的资金投入，由生产经营单位的决策机构、主要负责人或者个人经营的投资人予以保证，并对由于安全生产所必需的资金投入不足导致的后果承担责任。\n有关生产经营单位应当按照规定提取和使用安全生产费用，专门用于改善安全生产条件。安全生产费用在成本中据实列支。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C016",
      "lawId": "L002",
      "article": "第四十五条",
      "quote": "生产经营单位必须为从业人员提供符合国家标准或者行业标准的劳动防护用品，并监督、教育从业人员按照使用规则佩戴、使用。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C017",
      "lawId": "L002",
      "article": "第四十六条第一款",
      "quote": "生产经营单位的安全生产管理人员应当根据本单位的生产经营特点，对安全生产状况进行经常性检查；对检查中发现的安全问题，应当立即处理；不能处理的，应当及时报告本单位有关负责人，有关负责人应当及时处理。检查及处理情况应当如实记录在案。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C018",
      "lawId": "L002",
      "article": "第二十一条第（一）项",
      "quote": "建立健全并落实本单位全员安全生产责任制，加强安全生产标准化建设；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C019",
      "lawId": "L002",
      "article": "第二十一条第（二）项",
      "quote": "组织制定并实施本单位安全生产规章制度和操作规程；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C020",
      "lawId": "L002",
      "article": "第二十一条第（五）项",
      "quote": "组织建立并落实安全风险分级管控和隐患排查治理双重预防工作机制，督促、检查本单位的安全生产工作，及时消除生产安全事故隐患；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C021",
      "lawId": "L001",
      "article": "第十六条第一款第（五）项",
      "quote": "组织防火检查，及时消除火灾隐患；",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.119.gov.cn/gk/zcjd/2022/240.shtml"
    },
    {
      "id": "C022",
      "lawId": "L002",
      "article": "第二十四条",
      "quote": "矿山、金属冶炼、建筑施工、运输单位和危险物品的生产、经营、储存、装卸单位，应当设置安全生产管理机构或者配备专职安全生产管理人员。\n前款规定以外的其他生产经营单位，从业人员超过一百人的，应当设置安全生产管理机构或者配备专职安全生产管理人员；从业人员在一百人以下的，应当配备专职或者兼职的安全生产管理人员。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C023",
      "lawId": "L002",
      "article": "第三十八条第三款",
      "quote": "生产经营单位不得使用应当淘汰的危及生产安全的工艺、设备。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C024",
      "lawId": "L002",
      "article": "第四十一条第一款",
      "quote": "生产经营单位应当建立安全风险分级管控制度，按照安全风险分级采取相应的管控措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C025",
      "lawId": "L002",
      "article": "第二十二条",
      "quote": "生产经营单位的全员安全生产责任制应当明确各岗位的责任人员、责任范围和考核标准等内容。\n生产经营单位应当建立相应的机制，加强对全员安全生产责任制落实情况的监督考核，保证全员安全生产责任制的落实。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.mem.gov.cn/fw/flfgbz/fg/202107/t20210716_416558.shtml"
    },
    {
      "id": "C026",
      "lawId": "L008",
      "article": "6.1.1",
      "quote": "一个计算单元内配置的灭火器数量不得少于2具。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://ghzrzyw.beijing.gov.cn/zhengwuxinxi/zcwj/qtwj/202409/P020240914543945101730.pdf"
    },
    {
      "id": "C027",
      "lawId": "L007",
      "article": "10.0.5",
      "quote": "灭火器不应设置在可能超出其使用温度范围的场所，并应采取与设置场所环境条件相适应的防护措施。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://www.yantian.gov.cn/ytjsj/attachment/1/1561/1561739/12083207.pdf"
    },
    {
      "id": "C028",
      "lawId": "L009",
      "article": "6.1.1",
      "quote": "配电线路应装设短路保护和过负荷保护。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://files.anshan.gov.cn/files/ueditor/ASJKQ/jsp/upload/file/20211201/1638343166465002256.pdf"
    },
    {
      "id": "C029",
      "lawId": "L009",
      "article": "7.1.2第3项",
      "quote": "应防止外部的机械性损害。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://files.anshan.gov.cn/files/ueditor/ASJKQ/jsp/upload/file/20211201/1638343166465002256.pdf"
    },
    {
      "id": "C030",
      "lawId": "L002",
      "article": "第三十五条",
      "quote": "生产经营单位应当在有较大危险因素的生产经营场所和有关设施、设备上，设置明显的安全警示标志。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://source.nra.gov.cn/jglz/apjc/zcfg/202605/t20260530_351349.shtml"
    },
    {
      "id": "C031",
      "lawId": "L010",
      "article": "5.1.1",
      "quote": "一般条件下，用电产品的周围应留有足够的安全通道和工作空间，且不应堆放易燃、易爆和腐蚀性物品。",
      "checked": "2026-09-08",
      "status": "已核验",
      "sourceUrl": "https://wlt.fujian.gov.cn/zwgk/zcfg/zxwj/202603/P020260330570851056605.pdf"
