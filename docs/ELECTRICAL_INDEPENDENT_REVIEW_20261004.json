  "hazardDecisions": [
    {
      "hazardId": "H_CF_GEN_13",
      "decision": "APPROVE",
      "finding": "Annual-minimum periodic inspection, shortening for adverse conditions and pre-rainy-season inspection match6.3. Includes6.2 inspection and500V insulation test. Table1 retained by tested insulation location with2/7/2/5MΩ, never2/7/1 by tool class. Missing label/record alone is not asserted to prove no inspection."
    },
    {
      "hazardId": "H_GBT3787_PERIODIC_CHECK_MARK",
      "decision": "APPROVE",
      "finding": "Only after qualified periodic inspection: appropriate location and conspicuous/clear/correct qualification mark with all four required fields. Complete6.3 f preserved and distinct from whether inspection happened."
    },
    {
      "hazardId": "H_JGJT46_2024_BOX_PE",
      "decision": "APPROVE",
      "finding": "Construction temporary neutral-directly-grounded220/380V low-voltage system only. Both PE-terminal connection and yellow/green flexible insulated door-bond sentence match4.1.12. No inserted4mm², no invented door-mounted-equipment condition. Ordinary fixed-cabinet existing H stays separately bounded."
    },
    {
      "hazardId": "H_GB51251_MANUAL_SMOKE_WINDOW",
      "decision": "APPROVE",
      "finding": "Natural-smoke exhaust facility identity is required. Height1.3–1.5m only when high and inconvenient to open directly. Complete final sentence retaining9m/2000m² thresholds and concentrated manual/automatic facilities preserved as context. No uniform label rule; old obstructed maintenance mapping stays superseded."
    },
    {
      "hazardId": "H_GBT34525_CYLINDER_REGISTER",
      "decision": "APPROVE",
      "finding": "Technical bottle-store incoming/outgoing record only, triggered by actual movement. All five prescribed data categories preserved. Scope covers stated cylinder parameters, subject scope and excluded equipment; not statutory special-equipment use registration or a list posted outside a cabinet."
    },
    {
      "hazardId": "H_GBT34525_CYLINDER_STORE_ALARM",
      "decision": "APPROVE",
      "finding": "Only qualifying toxic/flammable/oxygen/inert-gas bottle stores and gas-corresponding hazardous-concentration detection. No made-up common threshold, UPS, automatic shutoff, or ventilation interlock. Not a general every-use-point or major-hazard determination."
    },
    {
      "hazardId": "H_89016FC0F3E849C2B8B8755C35",
      "decision": "APPROVE",
      "finding": "Only in-service lightning-protection devices: ordinary annual versus explosive/fire-hazard premises half-year periodicity. Art17 qualified institution is supporting. Not generic protective/static grounding, initial acceptance, design-coverage, or proof from a missing report alone. 2026-11-01 amendment and major rule not applied early."
    }
  ],
