{"schemaVersion":2,"records":[{"id":"C_GBT47236_4_2_4_5","article":"第4.2.4.5条","quote":"因熔融金属飞溅、高温辐射等造成电绝缘失效的电气设备及线路应采取隔热、防烫防护措施。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_1","article":"第4.2.5.1条","quote":"控制系统应能按规定动作顺序实现联锁。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_2","article":"第4.2.5.2条","quote":"电气联锁应具备防止因误动作引起的意外故障和/或危险事件发生的功能。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_3","article":"第4.2.5.3条","quote":"控制系统应具备必要的自动监控功能,在出现某一故障时触发报警器和在故障排除前不可能 启动一次新的工作循环。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_4","article":"第4.2.5.4条","quote":"如果设备有不同的工作模式(如手动、半自动、自动等),则应对不同的工作模式分别采用带有 钥匙锁定的选择开关或带有可卸手柄的转换开关。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_5","article":"第4.2.5.5条","quote":"控制系统中的暂停、停止装置复位后不应引发任何危险情况。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_6","article":"第4.2.5.6条","quote":"当动力或控制信号中断时,制动、夹紧、翻转、提升或下降等动作应能立即停止并保持当前 状态。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_7","article":"第4.2.5.7条","quote":"应采取措施防止动力供应失效带来的危险,包括动力不稳定、动力供应中断之后或控制回路被 切断时的意外重启;防止机器意外启动的控制系统内置安全措施应符合GB/T19670的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_5_8","article":"第4.2.5.8条","quote":"控制系统有关安全防护方面的设计应符合GB/T16855.1的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_1","article":"第4.2.6.1条","quote":"气动系统的安全要求应符合GB/T7932的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_2","article":"第4.2.6.2条","quote":"液压系统的安全要求应符合GB/T3766的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_3","article":"第4.2.6.3条","quote":"元器件、配件的选择应保证当系统投入预定的使用时能在额定极限内可靠运行。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_4","article":"第4.2.6.4条","quote":"高压气动系统、液压系统应安装有自动泄压装置。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_6","article":"第4.2.6.6条","quote":"液压系统的蓄能器应有自动泄压装置。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_6_7","article":"第4.2.6.7条","quote":"因熔融金属飞溅、高温辐射等造成失效的液压和气动设备及管路应采取隔热、防烫防护措施。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_7_1","article":"第4.2.7.1条","quote":"机器所设置的工作平台、通道、楼梯(或阶梯、直梯)和护栏等固定设施(以下称“接近设施”),应 符合规定,防止以下重大危险: a)坠落; b)滑倒、绊倒; c)可能对人员产生危险的物料或物体掉落。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_7_2","article":"第4.2.7.2条","quote":"接近设施的选择和基本要求应符合GB/T17888.1的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_7_3","article":"第4.2.7.3条","quote":"工作平台和通道应符合GB/T17888.2的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_7_4","article":"第4.2.7.4条","quote":"楼梯、阶梯和护栏应符合GB/T17888.3的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_7_5","article":"第4.2.7.5条","quote":"固定式直梯应符合GB/T17888.4的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_8_3","article":"第4.2.8.3条","quote":"对于可能会接触到机器或铸件热表面,使用说明书中应包括补充措施,如机器维护、维修、调整 时延长机器冷却时间、防止热危险的警示和使用个体防护装备。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_8_4","article":"第4.2.8.4条","quote":"对于所有其他可接近的受到热辐射的地方,宜采用隔离防护,并应在使用说明书中说明机器运 行时由于高温而产生的热危险和采取的必要措施,如保持安全距离和使用个体防护装备。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_9_1","article":"第4.2.9.1条","quote":"机器在空运转条件下的噪声声压级不应超过85dB(A)。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_2_9_3","article":"第4.2.9.3条","quote":"如果从源头和/或通过防护措施不足以降低噪声,则应给出使用信息,如使用个体防护装备。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_3_2","article":"第4.3.2条","quote":"一般要求 涉及重大危险、安全要求和/或风险减小措施,机器的一般要求应符合表1的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_3_3","article":"第4.3.3条","quote":"低压铸造机/差压铸造机 低压铸造机/差压铸造机的安全要求和/或风险减小措施应符合表2的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_3_4","article":"第4.3.4条","quote":"金属型重力铸造机 金属型重力铸造机的安全要求和/或风险减小措施应符合表3的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_3_5","article":"第4.3.5条","quote":"离心铸造机 离心铸造机的安全要求和/或风险减小措施应符合表4的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_4_3_6","article":"第4.3.6条","quote":"金属型铸造自动化生产单元及生产线 金属型铸造自动化生产单元及生产线的安全要求和/或风险减小措施应符合表5的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_5_1_1","article":"第5.1.1条","quote":"通则 对于按照第4章确定的机器的安全要求和/或风险减小措施可通过5.1.2~5.1.5所述的验证方法 进行验证。每一项安全技术要求和/或措施至少需用一种方法验证,根据机器的安全要求和/或风险减 小措施的性质,具体采用何种验证方法,应按照5.1.2~5.1.5的优先顺序,在前一种方法无法实施或不 能验证的情况下,允许按后一种方法验证,依次进行。当某一项安全技术要求和/或措施具有多种方法 可验证时,几种方法验证的结果均应相符。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_5_2","article":"第5.2条","quote":"验证清单 按照上述验证方法进行验证的过程宜优先选用现行有效且经标准化的验证方法。本文件范围内涉 及的机器的安全要求和/或风险减小措施的验证应按附录B进行。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_1_2","article":"第6.1.2条","quote":"机器使用信息应包括安全说明,安全说明可单独编写,也可作为使用说明书的一部分。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_2_2","article":"第6.2.2条","quote":"制造商应为机器的剩余风险提供信号和/或警告装置。机器的视觉信号如(警示灯)、听觉信号 (如报警器)应符合GB/T18209.1的要求。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_2_3","article":"第6.2.3条","quote":"机器操作面板或控制界面上应有反映机器安全运行、工作状态、故障等有关信息的指示。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_2_4","article":"第6.2.4条","quote":"机器的安全色和安全标志应符合GB2894的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_2_5","article":"第6.2.5条","quote":"指示灯信号颜色应符合GB/T5226.1—2019中10.3.2的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_3_1","article":"第6.3.1条","quote":"机器的标志、符号(象形图)和书面警告应符合GB/T15706—2012中6.4.4的规定。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"},{"id":"C_GBT47236_6_3_3","article":"第6.3.3条","quote":"机器还应在明显位置有机器性能和维护有关信息的标志,内容包括: a)各种信号、标志、文字警告; b)机器质量; c)人工润滑点; d)其他需要说明的内容。","lawId":"LV_STD_GBT47236_2026","sourceUrl":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=0A7C3D2DABA433E1DAA4A495EFF1A047","checked":"2026-09-12","status":"现行有效","region":"全国"}]}